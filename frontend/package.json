{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "vite build",
    "build:ios": "VITE_NATIVE_BUILD=true vite build && cap sync ios",
    "open:ios": "cap open ios",
    "build:android": "VITE_NATIVE_BUILD=true vite build && cap sync android",
    "open:android": "cap open android",
    "preview": "vite preview",
    "audit:gameplay": "node scripts/audit-gameplay-coverage.js",
    "sync:headshots": "node scripts/sync-headshot-assets.mjs",
    "sync:headshots:upload": "node scripts/sync-headshot-assets.mjs upload",
    "regen:headshots": "node scripts/regenerate-headshot-pool.mjs",
    "prebuild": "npm run sync:headshots && npm run regen:headshots && node scripts/audit-gameplay-coverage.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.30",
    "@revenuecat/purchases-capacitor": "^13.1.4",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.13.4",
    "firebase": "^12.9.0",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.2",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
