# Frontend env example. Copy to `.env` (or `.env.local`) for local dev,
# or set these in CI to use in the build pipeline.
#
# ASSETS_AWS_* credentials are consumed by scripts/sync-headshot-assets.mjs
# (the `prebuild` step) to pull the headshot bucket (bball-sim-assets) into
# src/assets/ before Vite bundles it. They are NOT exposed to the client —
# no `VITE_` prefix, on purpose. The script falls back to the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if the ASSETS_AWS_* pair isn't
# set. Without ASSETS_AWS_BUCKET the script logs a warning and the build
# proceeds against whatever's currently on disk.
ASSETS_AWS_BUCKET=bball-sim-assets
ASSETS_AWS_DEFAULT_REGION=sfo3
ASSETS_AWS_ENDPOINT=https://sfo3.digitaloceanspaces.com
ASSETS_AWS_ACCESS_KEY_ID=
ASSETS_AWS_SECRET_ACCESS_KEY=
ASSETS_AWS_ENDPOINT=https://sfo3.digitaloceanspaces.com


# Vite-exposed variables (bundled into the client). Keep secrets out of
# this section.
# VITE_API_URL=http://localhost:3000
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_REVENUECAT_API_KEY=             # iOS/App Store key (appl_…)
# VITE_REVENUECAT_API_KEY_ANDROID=     # Android/Play key (goog_…)
#
# Sign in with Google / Apple (web). Public client ids — safe to bundle.
# See docs/SOCIAL_AUTH_SETUP.md for how to obtain each value.
# VITE_GOOGLE_WEB_CLIENT_ID=        # Google Cloud OAuth "Web" client id
# VITE_APPLE_WEB_SERVICES_ID=       # Apple Services ID (e.g. com.bballsim.web)
# VITE_APPLE_WEB_REDIRECT_URI=      # Return URL registered on the Services ID (e.g. https://play.bball-sim.com/login)

# Support email for the in-app feedback composer (review nag "Not so much" branch)
VITE_SUPPORT_EMAIL=rmgriffus@comcast.net

# Public web-app origin (community handoff links). The root domain is the
# WordPress marketing site; the web app lives on the play. subdomain.
VITE_WEB_URL=https://play.bball-sim.com

# WebLinguist build-time translation CLI (`npm run translate`). Consumed only
# by vendor/wl-i18n/bin/translate.js on the dev machine — NOT VITE_-prefixed,
# on purpose, so they can never reach the client bundle. The app makes zero
# runtime calls to WebLinguist.
WL_LICENSE_KEY=
WL_TRANSLATE_API_URL=https://api.weblinguist.ai
