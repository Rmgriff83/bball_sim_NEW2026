# Release signing config for the Play Store upload keystore.
#
# Copy this file to `android/keystore.properties` (which is gitignored) and fill
# in your real values. `build.gradle` loads it and signs the release build; if
# the file is absent the release build is simply left unsigned.
#
# `storeFile` is resolved relative to the `android/` directory. Recommended:
# keep the keystore at android/app/upload-keystore.jks (also gitignored).

storeFile=app/upload-keystore.jks
storePassword=password
keyAlias=upload
keyPassword=password
