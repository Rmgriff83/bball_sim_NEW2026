APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base URL of the SPA frontend (no trailing slash). Used to build emailed
# links (password reset) and the email logo URL so they hit the app, not the
# API. Defaults to APP_URL when unset — which sends users to the API host,
# so production MUST set it (the web app lives on the play. subdomain; the
# root domain is the WordPress marketing site):
#   FRONTEND_URL=https://play.bball-sim.com
FRONTEND_URL=http://localhost:3000

# Public web-app origin used by the app→web login handoff (/autologin links).
# Defaults to https://play.bball-sim.com (config/app.php web_url).
#   WEB_APP_URL=https://play.bball-sim.com

# CORS + Sanctum: comma-separated origins allowed to call the API. Because
# config/cors.php sets supports_credentials=true, a wildcard is not usable —
# list exact origins:
#   CORS_ALLOWED_ORIGINS=https://play.bball-sim.com,...
#   SANCTUM_STATEFUL_DOMAINS=play.bball-sim.com,...
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Sign in with Google / Apple (native one-tap). See docs/SOCIAL_AUTH_SETUP.md.
# Only client ids are needed — identity tokens are verified server-side against
# each provider's JWKS; no client secret / Apple .p8 is required.
GOOGLE_WEB_CLIENT_ID=384957239257-6eb8r0bgrd9a8tcbbb3n8e362hcrfr78.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=384957239257-09so0k4po50mbg9r7e38oiuog4t0n2e6.apps.googleusercontent.com
APPLE_WEB_SERVICES_ID=
APPLE_APP_BUNDLE_ID=com.bballsim.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: keep MAIL_MAILER=log (emails land in storage/logs, nothing sends).
# Production: Resend over SMTP (see SERVER_SETUP.txt "EMAIL" section) —
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=2465   (not 465 — DigitalOcean blocks standard SMTP ports)
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<resend-api-key>
# Only password-reset emails are sent (signup verification email is disabled
# in app/Models/User.php).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bball-sim.com"
MAIL_FROM_NAME="Bball Sim - Dynasty Basketball"

# Default AWS_* — kept for the existing campaigns bucket (bball-sim-campaigns)
# wired through Storage::disk('s3') in config/filesystems.php.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Dedicated env namespace for the headshot-assets bucket (bball-sim-assets).
# Powers Storage::disk('assets') and AdminHeadshotController. Falls back to
# the AWS_* credentials above if the ASSETS_AWS_ACCESS_KEY_ID /
# ASSETS_AWS_SECRET_ACCESS_KEY pair isn't set, so a single IAM user with
# access to both buckets works without duplicating keys. Without
# ASSETS_AWS_BUCKET the admin headshot endpoints 503.
ASSETS_AWS_BUCKET=bball-sim-assets
ASSETS_AWS_DEFAULT_REGION=sfo3
ASSETS_AWS_ENDPOINT=https://sfo3.digitaloceanspaces.com
ASSETS_AWS_ACCESS_KEY_ID=
ASSETS_AWS_SECRET_ACCESS_KEY=

# Community roster-builds bucket — Storage::disk('roster_builds'), written by
# RosterBuildController (publish) and streamed back via the authed blob
# endpoint. The bucket MUST be private (no public ACLs, no CDN); blobs are
# only ever served through the API. ROSTER_BUILDS_AWS_BUCKET is REQUIRED (no
# fallback — publish 503s without it); the credential/region/endpoint vars
# fall back to the AWS_* pair above, so a single IAM user with access to all
# buckets works without duplicating keys.
ROSTER_BUILDS_AWS_BUCKET=
ROSTER_BUILDS_AWS_DEFAULT_REGION=sfo3
ROSTER_BUILDS_AWS_ENDPOINT=https://sfo3.digitaloceanspaces.com
ROSTER_BUILDS_AWS_ACCESS_KEY_ID=
ROSTER_BUILDS_AWS_SECRET_ACCESS_KEY=

# Where roster-build report notices (and other operational alerts) are sent.
ADMIN_NOTICE_EMAIL=dev@growthdyn.com

VITE_APP_NAME="${APP_NAME}"

# Stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TOKENS_1000=
STRIPE_PRICE_TOKENS_6500=
STRIPE_PRICE_HEADSHOT_EDITOR_UNLOCK=
STRIPE_PRICE_CUSTOM_ROSTER_UNLOCK=
# Stripe redirects users back to the frontend after checkout. In production
# these must point at the web app on the play. subdomain, e.g.
#   STRIPE_CHECKOUT_SUCCESS_URL=https://play.bball-sim.com/store?checkout=success
#   STRIPE_CHECKOUT_CANCEL_URL=https://play.bball-sim.com/store?checkout=cancel
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/store?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/store?checkout=cancel

# FRONTEND_ASSETS_PATH is deprecated — admin headshot writes go to S3 now.
# The variable is no longer read by AdminHeadshotController; it can be
# removed from existing .env files.
# FRONTEND_ASSETS_PATH=
